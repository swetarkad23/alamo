#working input file with chamber model/variable pressure
#input file with higher dimension;finally the mdot_out is updating now with pressure :)
#thermo.dat issue fixed; (old flame) to see the variables in thermo.dat with just thermo on, need to comment out the lines 491-493 in flame where if(variable pressure)...; refinement issue fixed for just thermo on

allow_unused=True

alamo.program = flame
plot_file = output
amr.plot_int = 1
amr.max_level = 3
amr.blocking_factor = 4
amr.base_regrid_int = 100
amr.grid_eff = 1
amr.node.all = 1
amr.refinement_criterion = 0.05 
amr.refinement_criterion_temp = 1.0_K
#amr.refinement_restriction = 0.3
amr.n_cell = 32 32 32
amr.thermo.plot_int = 1
amr.thermo.int = 1
geometry.prob_lo = 0.0_m 0.0_m # [m]
geometry.prob_hi = 0.1_m 0.1_m # [m]
geometry.is_periodic = 0 0 0

system.length = m
system.time = s

# Timestep and duration
timestep = 1.0e-5_s # [s]
stop_time = 5.0_s # [s]

# Phase field parameters
pf.eps = 0.00008_m # [m]
pf.lambda = 0.001_J/m^2

#pf.eta.ic.type       = expression
#pf.eta.ic.expression.region0    = "1.0*(x > 0.05)"

#phi.ic.type          = expression
#phi.ic.expression.region0       = "1.0*(x > 0.05)"

pf.eta.ic.type = expression
pf.eta.ic.expression.region0 = "0.5 * erf(500*(x - 0.05)) + 0.5"

phi.ic.type = expression
phi.ic.expression.region0 = "1 * (x > 0.05)"


pf.kappa = 1.0_J/m^2
pf.w1 = 1.0_1
pf.w12 = 2.0_1
pf.w0 = 0.0_1
small = 1E-4

# Eta boundary condition
pf.eta.bc.type = constant
pf.eta.bc.constant.type.xlo = dirichlet
pf.eta.bc.constant.type.xhi = dirichlet
pf.eta.bc.constant.type.ylo = dirichlet
pf.eta.bc.constant.type.yhi = dirichlet
pf.eta.bc.constant.val.xlo = 1.0
pf.eta.bc.constant.val.xhi = 1.0
pf.eta.bc.constant.val.ylo = 1.0
pf.eta.bc.constant.val.yhi = 1.0

#propellant.type = constant
#propellant.constant.K = 1E-8
#propellant.constant.cp = 1
#propellant.constant.rho = 1
#propellant.constant.qdot = 0
#propellant.constant.L = 0

propellant.type = homogenize
#propellant.homogenize.m_ap         = 1.45e5_cm/s #[???] cm/s
propellant.homogenize.m_ap         = 0.0000_cm/s #[???] cm/s
propellant.homogenize.m_htpb       = 0.0000_cm/s #[???] cm/s
propellant.homogenize.E_ap         = 9500.0_K  # Note that this is actually E/R 
propellant.homogenize.E_htpb       = 0.0000_K #[???] K
propellant.homogenize.rho_ap       = 1450.0_kg/m^3    # [kg/m3]
propellant.homogenize.rho_htpb     = 920.0_kg/m^3   # [kg/m3]
propellant.homogenize.k_ap         =  0.1_W/m/K      # [W/mK]
propellant.homogenize.k_htpb       =  0.283_W/m/K    # [W/mK]
propellant.homogenize.cp_ap        = 1531_J/kg/K       # [J/kgK]
propellant.homogenize.cp_htpb      = 1256_J/kg/K     # [J/kgK]
propellant.homogenize.massfraction = 0.8_1 # [1]
propellant.homogenize.dispersion1  = 0.1_W/m/K # [W/mK]
propellant.homogenize.dispersion2  = 1.0_kg/m^3  # [kg/m3]
propellant.homogenize.dispersion3  = 1.0_J/kg/K # [J/kgK]

# Controls weather or not pressure affects the mobility or not.
# Effectively changes the units of m_ap if set to 1.
propellant.homogenize.mob_ap       = false 

propellant.homogenize.mlocal_ap = 1000.0_kg/m^2/s # [???] kg/s
propellant.homogenize.h1        = 1.81_W/m^2 # W/N
propellant.homogenize.h2        = 1.34_W/m^2 # W/m^2

propellant.homogenize.Pref = 1_MPa

thermal.on = 1
thermal.Tref = 500 #[K]
thermal.temp.bc.type = constant
thermal.temp.bc.constant.type.xlo = neumann
thermal.temp.bc.constant.type.xhi = neumann
thermal.temp.bc.constant.type.ylo = neumann
thermal.temp.bc.constant.type.yhi = neumann
thermal.temp.bc.constant.val.xlo = 0.0
thermal.temp.bc.constant.val.xhi = 0.0
thermal.temp.bc.constant.val.ylo = 0.0
thermal.temp.bc.constant.val.yhi = 0.0

# Temperature initial conditions
temp.ic.type="constant"
temp.ic.constant.value=500_K #[K]

# Laser source term
laser.ic.type = constant
laser.ic.constant.value = 1.0e1_kW/m^2 #[ Units? ] kW/cm^2
thermal.hc = 1.0e1_kW/m^2 # [ ???] This converts kW/cm^2 to W/m^2 (so units of (W cm^2) / ( kW m^2) )

# Pressure
variable_pressure = 1
chamber.pressure = 4.0_MPa # [MPa?] yes MPa
chamber.ballistic.At = 1.0_m^2 # [?] m^2
chamber.ballistic.T0 = 500_K # [?] K 
chamber.ballistic.R = 0.000287_J/kg/K #[?] J/kg/K

# Thermoelasticity
#elastic.on = 0
elastic.type = disable #static

